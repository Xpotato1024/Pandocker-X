{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["title", "author", "lang"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "author": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lang": {"type": "string"},
    "date": {"type": "string"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"toc": {"type": "boolean"}, "numbersections": {"type": "boolean"}}
    }
  }
}
