{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pdx.lock schema 1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "templates", "runtime"],
  "properties": {
    "schema_version": {"const": 1},
    "runtime": {"const": "unresolved"},
    "templates": {"type": "object", "additionalProperties": {"$ref": "#/definitions/identity"}}
  },
  "definitions": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    }
  }
}
