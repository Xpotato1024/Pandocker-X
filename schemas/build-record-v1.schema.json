{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "build-record schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "target",
    "document",
    "template",
    "runtime",
    "evidence",
    "inputs",
    "ordered_inputs",
    "pdf",
    "pdf_verified",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build_id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "document": {
      "type": "string"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "platform"
      ],
      "properties": {
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "const": "linux/amd64"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "runtime_verified",
        "tools"
      ],
      "properties": {
        "driver": {
          "type": "string"
        },
        "runtime_verified": {
          "type": "boolean"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ordered_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pdf_verified": {
      "type": "boolean"
    },
    "status": {
      "const": "committed"
    }
  }
}
