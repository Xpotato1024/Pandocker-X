{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pdx.toml schema 1 (JSON representation)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_target", "documents", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "default_target": {"type": "string"},
    "documents": {"type": "object", "additionalProperties": {"$ref": "#/definitions/document"}},
    "targets": {"type": "object", "additionalProperties": {"$ref": "#/definitions/target"}}
  },
  "definitions": {
    "paths": {"type": "array", "items": {"type": "string"}},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "sources", "bibliography", "resources"],
      "properties": {
        "format": {"const": "markdown"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "metadata": {"type": ["string", "null"]},
        "bibliography": {"$ref": "#/definitions/paths"},
        "resources": {"$ref": "#/definitions/paths"}
      }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "properties": {"id": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}},
      "oneOf": [
        {"required": ["id"], "properties": {"id": {"type": "string"}, "path": {"type": "null"}}},
        {"required": ["path"], "properties": {"path": {"type": "string"}, "id": {"type": "null"}}}
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["document", "template", "output_dir"],
      "properties": {
        "document": {"type": "string"}, "template": {"$ref": "#/definitions/template"},
        "metadata": {"type": ["string", "null"]}, "output_dir": {"type": "string"}
      }
    }
  }
}
