{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildPlan schema 1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "target", "document", "recipe", "ordered_inputs", "bibliography", "resources", "metadata_inputs", "merged_metadata", "template", "template_source", "template_files", "output_dir", "required_tools", "runtime", "static_only", "runtime_verified", "build_ready", "unverified"],
  "properties": {
    "schema_version": {"const": 1}, "target": {"type": "string"}, "document": {"type": "string"}, "recipe": {"const": "markdown-standalone"},
    "ordered_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bibliography": {"$ref": "#/definitions/strings"}, "resources": {"$ref": "#/definitions/strings"},
    "metadata_inputs": {"$ref": "#/definitions/strings"}, "template_files": {"$ref": "#/definitions/strings"},
    "merged_metadata": {"type": "object"},
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "template_source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {"id": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}}
    },
    "output_dir": {"type": "string"}, "required_tools": {"$ref": "#/definitions/strings"},
    "runtime": {"const": "unresolved"}, "static_only": {"const": true}, "runtime_verified": {"const": false}, "build_ready": {"const": false},
    "unverified": {"$ref": "#/definitions/strings"}
  },
  "definitions": {"strings": {"type": "array", "items": {"type": "string"}}}
}
